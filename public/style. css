* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #0b1220;
  color: #ffffff;
  font-family: Arial, sans-serif;
}

.container {
  max-width: 1000px;
  margin: auto;
  padding: 16px;
}

.header {
  background: #111c31;
  border: 1px solid #293956;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.header h1 {
  margin: 0 0 6px;
  font-size: 25px;
}

.header p {
  margin: 0;
  color: #9caac1;
}

.status {
  padding: 9px 13px;
  border-radius: 20px;
  font-size: 13px;
  white-space: nowrap;
}

.status.online {
  background: #14532d;
  color: #86efac;
}

.status.offline {
  background: #450a0a;
  color: #fca5a5;
}

.card {
  background: #111c31;
  border: 1px solid #293956;
  border-radius: 16px;
  padding: 18px;
  margin-bottom: 16px;
}

.card h2 {
  margin-top: 0;
  font-size: 19px;
}

.channels {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(150px, 1fr));
  gap: 10px;
}

.channelButton {
  border: 1px solid #344866;
  background: #17243a;
  color: #ffffff;
  border-radius: 12px;
  padding: 15px;
  text-align: left;
  cursor: pointer;
  min-height: 85px;
}

.channelButton:hover {
  border-color: #2563eb;
}

.channelButton.selected {
  border-color: #3b82f6;
  background: #173b72;
}

.channelButton small {
  color: #9caac1;
}

.selected {
  margin-top: 12px;
  color: #60a5fa;
  font-weight: bold;
}

.uploadBox {
  display: block;
  text-align: center;
  padding: 30px 15px;
  border: 2px dashed #425574;
  border-radius: 14px;
  cursor: pointer;
  background: #0f1a2d;
}

.uploadBox:hover {
  border-color: #3b82f6;
}

.uploadIcon {
  font-size: 32px;
  margin-bottom: 8px;
}

.uploadBox small {
  display: block;
  color: #9caac1;
  margin-top: 6px;
}

.fileList {
  margin-top: 14px;
}

.fileItem {
  background: #17243a;
  border-radius: 10px;
  padding: 12px;
  margin-top: 8px;
}

.fileStatus {
  margin-top: 7px;
  color: #9caac1;
  font-size: 13px;
}

.progress {
  width: 100%;
  height: 8px;
  background: #2b3b56;
  border-radius: 10px;
  overflow: hidden;
  margin-top: 9px;
}

.progressBar {
  height: 100%;
  width: 0%;
  background: #2563eb;
  transition: width 0.3s ease;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

button {
  border: 0;
  border-radius: 9px;
  padding: 11px 15px;
  font-weight: bold;
  color: #ffffff;
  background: #334155;
  cursor: pointer;
}

button:hover {
  opacity: 0.9;
}

button.primary {
  background: #2563eb;
}

button.danger {
  background: #dc2626;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.stat {
  flex: 1;
  min-width: 120px;
  background: #17243a;
  border-radius: 12px;
  padding: 15px;
}

.stat span {
  display: block;
  color: #9caac1;
  font-size: 13px;
  margin-bottom: 5px;
}

.stat strong {
  font-size: 25px;
}

.stat.success strong {
  color: #4ade80;
}

.stat.failed strong {
  color: #f87171;
}

.queue {
  min-height: 40px;
}

.empty {
  color: #7f8da3;
  padding: 10px 0;
}

.logs {
  background: #080f1b;
  border-radius: 10px;
  padding: 12px;
  min-height: 80px;
  max-height: 250px;
  overflow-y: auto;
  font-family: monospace;
  font-size: 12px;
  line-height: 1.6;
}

@media (max-width: 600px) {

  .container {
    padding: 10px;
  }

  .header {
    flex-direction: column;
    align-items: flex-start;
  }

  .header h1 {
    font-size: 21px;
  }

  .buttons button {
    width: 100%;
  }

  .status {
    white-space: normal;
  }
}
